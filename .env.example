# 复制为 .env 后按需覆盖；标注「用户级环境变量」的项本机已配好，无需写入
# 用途：演示项目配置结构。真实密钥永远不要提交进 Git。
#
# 零配置起步：全部留空也能跑 ——
#   数据库默认落 SQLite（data/db/olist.db），LLM 默认从用户级环境变量读 AGNES_API_KEY。
#   （DB_URL / DB_RO_URI 的字段默认值由 src/core/config.py 在运行时拼出，无需在此重复声明。）

# ---------- LLM 提供方 ----------
LLM_PROVIDER=agnes                # agnes | deepseek

# Agnes（用户级环境变量 AGNES_API_KEY 已配置，一般无需在此设置）
# AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# DeepSeek（备用；用户级环境变量 DEEPSEEK_API_KEY 已配置）
# DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---------- 数据库（SQLAlchemy URL 抽象：SQLite 开发 / MySQL 生产只改这一行）----------
# 开发（默认）：留空即落 data/db/olist.db
# DB_URL=sqlite:///D:/Myprojects/text2sql-agent/data/db/olist.db
#
# 生产形态（MySQL 8.4）：需要先建库与只读/读写账号，见 scripts/init_db_mysql.py
#   agent_ro 仅 SELECT —— 四层安全的第①层（库层兜底）
#   agent_rw 仅用于 S9 写路径的人审执行（读路径永不使用）
# DB_URL=mysql+pymysql://agent_ro:CHANGE_ME@127.0.0.1:3306/olist?charset=utf8mb4

# ---------- 评测资产（一般无需改）----------
# GOLDSET_PATH=
# FEWSHOTS_PATH=

# ---------- 场景包（默认为 Olist 电商；换场景只改这里，图/安全/工具零改动）----------
# SCENARIO=olist
